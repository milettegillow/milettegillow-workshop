      0 1px 2px rgba(0, 0, 0, 0.3),
      inset 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .close-icon {
    color: #F5E6D3;
    font-size: 1.5rem;
    font-weight: bold;
    font-family: 'Playfair Display', serif;
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
