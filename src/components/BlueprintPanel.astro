  .victorian-close-btn::before {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 2px;
    pointer-events: none;
  }

  .victorian-close-btn:hover {
    background: #5C3F2A;
    border-color: #F4D03F;
    box-shadow: 
      0 3px 6px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
  }

  .victorian-close-btn:active {
    transform: translateY(0);
