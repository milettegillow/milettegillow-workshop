---
import { getEntry, getCollection } from 'astro:content';

let page;
let Content;

try {
  // Try getEntry first (recommended approach)
  page = await getEntry('pages', 'what-im-doing');
  if (page) {
    const rendered = await page.render();
    Content = rendered.Content;
  }
} catch (error) {
  // Fallback to getCollection + find if getEntry fails
  try {
    const pages = await getCollection('pages');
    page = pages.find(p => p.id === 'what-im-doing' || p.id === 'pages/what-im-doing' || p.slug === 'what-im-doing');
    if (page) {
      const rendered = await page.render();
      Content = rendered.Content;
    } else {
      console.warn('Page "what-im-doing" not found in pages collection');
    }
  } catch (fallbackError) {
    console.error('Error loading pages collection:', fallbackError);
  }
}

if (!page) {
  page = { data: { title: "What I'm Doing" } };
  Content = null;
}
---

<div id="blueprint-overlay" class="panel-overlay fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="overlay-backdrop absolute inset-0 bg-black bg-opacity-75" id="blueprint-backdrop"></div>
  
  <div class="panel-container relative z-10 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="panel-content panel-paper shadow-2xl p-8 relative">
      <button 
        id="blueprint-close"
        class="victorian-close-btn absolute top-0 right-0 z-30"
        aria-label="Close Panel"
      >
        <span class="close-icon">×</span>
      </button>
      <h2 class="text-victorian-dark font-display text-3xl font-bold mb-6 text-center">
        {page.data.title}
      </h2>
      
      <div class="text-victorian-dark space-y-4 prose prose-invert max-w-none">
        {Content ? <Content /> : (
          <>
            <p class="text-lg leading-relaxed">
              This is my weekly coding diary for 2026.
            </p>
            
            <p class="leading-relaxed">
              I come from a mathematics background, so for a long time I've assumed that one day I'd be able to do the coding thing properly. But assumption isn't the same as fluency - and over time, engineering started to feel like a black box I didn't fully understand.
            </p>
            
            <p class="leading-relaxed">
              I want to change that.
            </p>
            
            <p class="leading-relaxed">
              The goal here is simple: to get to the point where building things feels easy, intuitive, and genuinely fun. To stop treating engineering as something abstract, and start treating it as a craft I can use fluently.
            </p>
            
            <p class="leading-relaxed">
              So for the whole of 2026, I'm building something every single week.
            </p>
            
            <p class="leading-relaxed">
              Some weeks will take a couple hours; some multiple days.
              Some weeks will be scrapped; some will be ambitious.
              But the key is that - whether a tool, a site, an experiment, a prototype, or a half-formed idea - each week, I have to ship.
            </p>
            
            <p class="leading-relaxed">
              That rule exists for a reason. Perfectionism is a fantastic way to never finish anything, so this project is deliberately structured to prioritise momentum over polish.
            </p>
            
            <p class="leading-relaxed">
              Alongside the builds, I'll share what I can about the process: this is as much a record for my future self as it is something I'm sharing publicly.
            </p>
            
            <p class="leading-relaxed">
              Follow along for the journey - I can't wait to see where it takes me!
            </p>
          </>
        )}
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('blueprint-overlay');
  const backdrop = document.getElementById('blueprint-backdrop');
  const closeBtn = document.getElementById('blueprint-close');
  const blueprintBtn = document.getElementById('blueprint-btn');

  if (!overlay || !backdrop || !closeBtn || !blueprintBtn) {
    throw new Error('Blueprint panel elements not found');
  }

  function openPanel() {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    
    requestAnimationFrame(() => {
      overlay.style.opacity = '0';
      requestAnimationFrame(() => {
        overlay.style.transition = 'opacity 0.3s ease';
        overlay.style.opacity = '1';
      });
    });
  }

  function closePanel() {
    overlay.style.transition = 'opacity 0.3s ease';
    overlay.style.opacity = '0';
    setTimeout(() => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }, 300);
  }

  blueprintBtn.addEventListener('click', openPanel);
  closeBtn.addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);

  document.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('hidden') && e.key === 'Escape') {
      closePanel();
    }
  });
</script>

<style>
