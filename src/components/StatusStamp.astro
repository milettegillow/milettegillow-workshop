---
interface Props {
  status: 'SHIPPED' | 'FAILED' | 'WIP' | 'LOGGED' | 'PATCHED';
  shippedDate?: string;
}

const { status, shippedDate } = Astro.props;

const statusColors = {
  SHIPPED: { bg: '#2d5016', text: '#a8d88a', shadow: '#1a3009' },
  FAILED: { bg: '#6b1a1a', text: '#ff9a9a', shadow: '#3d0f0f' },
  WIP: { bg: '#1a3a5c', text: '#9ac5e8', shadow: '#0f2235' },
  LOGGED: { bg: '#2a2a2a', text: '#d4d4d4', shadow: '#1a1a1a' },
  PATCHED: { bg: '#3d1a5c', text: '#c59ae8', shadow: '#220f35' },
};

const colors = statusColors[status];
const rotation = Math.random() * 4 - 2; // Random rotation between -2 and 2 degrees
---

<div 
  class="status-stamp"
  style={`--stamp-rotation: ${rotation}deg; --stamp-bg: ${colors.bg}; --stamp-text: ${colors.text}; --stamp-shadow: ${colors.shadow};`}
>
  <div class="stamp-content">
    {status}
    {shippedDate && <div class="stamp-date">{shippedDate}</div>}
  </div>
</div>

<style>
  .status-stamp {
    display: inline-block;
    transform: rotate(var(--stamp-rotation));
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .stamp-content {
    background: var(--stamp-bg);
    color: var(--stamp-text);
    padding: 0.5rem 1rem;
    border: 2px solid var(--stamp-shadow);
    border-radius: 2px;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    box-shadow: 
      inset 0 1px 2px rgba(255, 255, 255, 0.2),
      0 2px 4px var(--stamp-shadow),
      inset 0 -1px 2px rgba(0, 0, 0, 0.3);
    opacity: 0.85;
  }

  .stamp-content::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(0, 0, 0, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .stamp-date {
    font-size: 0.6rem;
    margin-top: 0.25rem;
    opacity: 0.9;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 0.25rem;
  }
</style>

